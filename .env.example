OA_BASE_URL=http://oa.sdthkj.com:9081
OA_USERNAME=your_oa_account
OA_PASSWORD=your_oa_password
OA_TIMEOUT_MS=20000

# Docker / Streamable HTTP，随机令牌：openssl rand -hex 32
MCP_AUTH_TOKEN=
MCP_PUBLISHED_PORT=3211
MCP_BIND_IP=0.0.0.0
# 本地 npm run start:http 默认监听 127.0.0.1；Docker 自动使用 0.0.0.0
MCP_HOST=127.0.0.1
MCP_PORT=3211
# 平台后端通常不带 Origin，无需填写。若带 Origin，填写精确来源，多个用逗号分隔。
MCP_ALLOWED_ORIGINS=

# 预留给以后接入 RestNew 流程服务；当前通讯录工具不使用策略账号。
OA_POLICY_USERNAME=
OA_POLICY_PASSWORD=

# 本地模型聊天页面，启动命令：npm run web
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash-0731
LLM_API_KEY=your_model_api_key
WEB_PORT=3210
